# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# JWT 登录密钥，正式部署请修改 JWT_SECRET。登录会话由服务端统一执行 7 天空闲、30 天最长有效期。
JWT_SECRET=change-me-jwt-secret

# 后端监听端口
PORT=8080

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/blink-workbench.db
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/blink-workbench.db

# 生成媒体按项目分类写入后端本地磁盘；不是云端同步目录。
PROJECT_CACHE_DIR=data/project-cache

# 视频工作流由内嵌后端 Worker 统一执行。默认全局并发 2、单用户并发 1；租约过期任务会自动恢复。
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_WORKER_CONCURRENCY=2
WORKFLOW_WORKER_USER_CONCURRENCY=1
WORKFLOW_WORKER_POLL_MS=2000
WORKFLOW_WORKER_LEASE_SECONDS=60
WORKFLOW_LOCAL_MEDIA_DIR=data/workflow-media

# 画布图片超分由后端调用阿里云图像增强服务。图片会进入阿里云基础设施，调用可能产生费用。
# AccessKey 仅配置在后端环境变量中，不要写入 NEXT_PUBLIC_*、前端配置或提交到 Git。
IMAGE_UPSCALE_PROVIDER=aliyun
IMAGE_UPSCALE_WORK_DIR=data/image-upscale
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 使用 STS 临时凭据时填写；长期 AccessKey 留空即可。
ALIBABA_CLOUD_SECURITY_TOKEN=

# 画布视频超分复用“后台设置 → 私有设置 → 火山素材审核”中的 AK/SK，只在服务端保存输入与增强结果。
# VOD 空间名称、独立开关和增强策略在“后台设置 → 私有设置 → 视频超分”中配置。
VIDEO_UPSCALE_WORK_DIR=data/video-upscale

# 即梦 CLI 登录态与生成文件都保存在现有 data 数据卷中；不要把登录凭据写入镜像或 Git。
DREAMINA_HOME=/app/data/dreamina-home
DREAMINA_OUTPUT_DIR=/app/data/jimeng-cli
