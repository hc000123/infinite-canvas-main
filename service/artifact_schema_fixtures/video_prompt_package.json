{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shotId", "prompt", "inputArtifactRefs"],
        "properties": {
          "shotId": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "inputArtifactRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifactId", "contentHash"],
              "properties": {
                "bindingName": {"type": "string", "minLength": 1},
                "artifactId": {"type": "string", "minLength": 1},
                "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]+$"}
              }
            }
          }
        }
      }
    }
  }
}
