{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["shots"],
  "properties": {
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shotId", "sceneKey", "sourceScript", "shotDraft"],
        "properties": {
          "shotId": {"type": "string", "minLength": 1},
          "sceneKey": {"type": "string", "minLength": 1},
          "sourceScript": {"type": "string", "minLength": 1},
          "shotDraft": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shotSize", "camera", "movement", "action", "performance", "dialogue", "durationSeconds", "continuityMode"],
            "properties": {
              "shotSize": {"type": "string", "minLength": 1},
              "camera": {"type": "string", "minLength": 1},
              "movement": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "performance": {"type": "string", "minLength": 1},
              "dialogue": {"type": "string"},
              "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
              "continuityMode": {"type": "string", "enum": ["continuous", "cut"]}
            }
          }
        }
      }
    }
  }
}
